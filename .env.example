# Chave da SportsDataAPI (odds em tempo real - Bet365)
# Cadastro gratuito em: https://sportsdataapi.com
ODDS_API_KEY=

# Chave alternativa odds-api.io (fallback caso SportsDataAPI não funcione)
# Cadastro gratuito em: https://odds-api.io
ODDS_API_KEY_ALT=

# Chave da Anthropic (geração de texto com Claude e busca web)
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Autenticação simples (login + senha) ────────────────────────────────────
# Lista de usuários no formato:  user1:senha1,user2:senha2,user3:senha3
# Exemplo: APP_USERS=thiago:senha123,maria:outraSenha,joao:abc456
APP_USERS=admin:troque-essa-senha

# (Opcional, legado) usuário único — usado se APP_USERS não estiver definido,
# ou somado à lista do APP_USERS se ambos existirem.
# APP_USERNAME=
# APP_PASSWORD=

# Segredo usado para assinar o cookie de sessão (HMAC).
# Use uma string aleatória de pelo menos 32 caracteres.
# Gere uma com: openssl rand -base64 32  (ou no PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)) )
AUTH_SECRET=troque-por-uma-string-aleatoria-de-32-caracteres-ou-mais
